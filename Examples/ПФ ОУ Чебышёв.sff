# Активный RC на операционных усилителях: каскады Саллен-Ки / MFB, номиналы
# R и C — на вкладке «Схема», добротность и f0 каждого каскада подписаны.
# Полоса ВЫБРАНА УЗКОЙ намеренно: каскаду MFB нужна добротность (2Q² > A0),
# и на широкой полосе (скажем, 300…3400 Гц) программа ОТКАЖЕТ вслух —
# «усиление в центре меньше 0 дБ: каскаду MFB не хватает 2Q²>A0».
[Filter]
format=sff-1
kind=opamp
shape=bandpass
approx=chebyshev1
f1=1000
f2=1200
ap_db=1
order=2
