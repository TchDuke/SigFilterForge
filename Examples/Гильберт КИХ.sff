# Преобразователь Гильберта: сдвигает все частоты полосы на 90° — из него
# делают аналитический сигнал, огибающую и однополосную модуляцию.
# Форма «Гильберт» есть ТОЛЬКО у КИХ: при смене класса она откатится к ФНЧ.
[Filter]
format=sff-1
kind=fir
shape=hilbert
fd=48000
fpass1=1000
fpass2=23000
fir_taps=63
