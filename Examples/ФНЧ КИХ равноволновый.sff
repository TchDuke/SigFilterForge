# Классика цифровой фильтрации: КИХ с равномерными пульсациями
# (Паркс-Маклелланд). Звуковой тракт 44.1 кГц: пропускаем до 15 кГц, с 19 кГц
# давим на 80 дБ. Длина N подбирается сама (0) — смотрите, во что обошлось
# требование: строка состояния назовёт достигнутые пульсацию и подавление.
[Filter]
format=sff-1
kind=fir
shape=lowpass
approx=butterworth
fd=44100
fpass1=15000
fstop1=19000
ap_db=0.1
as_db=80
fir_taps=0
